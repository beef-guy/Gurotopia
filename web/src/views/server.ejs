<%- include('partials/head') %>
<p class="crumb"><a href="/servers">Your servers</a> /</p>
<div class="title-row">
  <h1><%= server.name %></h1>
  <span id="status-badge"><%- include('partials/badge', { view }) %></span>
</div>
<% if (error) { %><p class="notice bad"><%= error %></p><% } %>
<p id="status-detail" class="muted"><%= view.detail %></p>

<section class="stats">
  <div><span class="label">Players online</span><span class="value"><span id="online"><%= server.online %></span> / <%= server.maxPlayers %></span></div>
  <div><span class="label">How players join</span><span class="value small">Type <strong><%= server.name %></strong> as the server name<% if (config.gameAddress) { %> on <%= config.gameAddress %><% } %></span></div>
  <div><span class="label">Port</span><span class="value small"><%= server.port %></span></div>
  <% if (user.isAdmin && server.ownerId !== user.id) { %>
  <div><span class="label">Owner</span><span class="value small"><%= server.ownerName || ('#' + server.ownerId) %></span></div>
  <% } %>
</section>

<section class="controls">
  <% for (const action of ['start', 'stop', 'restart']) { %>
  <form method="post" action="/servers/<%= server.id %>/<%= action %>" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="<%= action === 'start' ? '' : 'ghost' %>" data-action="<%= action %>"><%= action[0].toUpperCase() + action.slice(1) %></button>
  </form>
  <% } %>
</section>

<section class="card">
  <div class="title-row"><h2>Log</h2><label class="toggle"><input type="checkbox" id="follow" checked> Follow</label></div>
  <pre id="log" class="log" data-server="<%= server.id %>">Loading…</pre>
</section>

<section class="card">
  <h2>Settings</h2>
  <form method="post" action="/servers/<%= server.id %>/settings" class="grid-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Max players
      <input name="maxPlayers" type="number" min="1" max="<%= config.maxPlayersLimit %>" value="<%= server.maxPlayers %>" required>
      <small>Takes effect after a restart.</small>
    </label>
    <button type="submit" class="ghost">Save</button>
  </form>
</section>

<section class="card danger">
  <h2>Delete server</h2>
  <p>This stops the server and deletes its players, worlds and log for good. It can't be undone.</p>
  <form method="post" action="/servers/<%= server.id %>/delete" class="grid-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Type <strong><%= server.name %></strong> to confirm
      <input name="confirm" autocomplete="off" required>
    </label>
    <button type="submit" class="bad">Delete forever</button>
  </form>
</section>
<script src="/static/server.js"></script>
<%- include('partials/foot') %>
