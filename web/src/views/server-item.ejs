<%- include('partials/server-shell') %>
<%
  const v = (key, fallback) => (form[key] !== undefined ? form[key] : fallback);
  const raritySet = (r) => r > 0 && r < 999;
  const iconSrc = (it) => `/servers/${server.id}/items/texture.png?file=${encodeURIComponent(v('texture', it.texture))}&x=${v('texX', it.texX)}&y=${v('texY', it.texY)}`;
%>
<p class="crumb"><a href="/servers/<%= server.id %>/items"><svg class="ic"><use href="#i-back"/></svg>All items</a></p>

<%- include('partials/items-pending') %>

<% if (!ready) { %>
<section class="card"><div class="empty"><svg class="ic big"><use href="#i-box"/></svg><p>Start the server once with the latest game build and its items show up here.</p></div></section>
<% } else if (!item) { %>
<!-- ---------- new item ---------- -->
<div class="page-head">
  <div>
    <h1>New item</h1>
    <p class="muted">A new item starts as a copy of one of the game's items, so it already looks and works like it. Its seed is made too. Change anything you like after.</p>
  </div>
</div>
<form method="post" action="/servers/<%= server.id %>/items" class="card new-item" id="new-item" data-server="<%= server.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card-head"><h2><svg class="ic"><use href="#i-copy"/></svg>Copy from</h2></div>
  <div class="base-pick">
    <label>Search the game's items
      <input type="search" id="base-search" placeholder="e.g. Legendary Wings or #1784" autocomplete="off" value="<%= base ? base.name : '' %>">
      <small>Pick one from the list. A seed counts as its block.</small>
    </label>
    <input type="hidden" name="base" id="base-id" value="<%= base ? base.id : v('base', '') %>">
    <ul class="base-results" id="base-results" role="listbox" aria-label="Matching items"></ul>
    <div class="base-chosen" id="base-chosen" <%= base ? '' : 'hidden' %>>
      <span class="item-ic big" data-letter="<%= base ? base.name.slice(0, 1) : '' %>"><img id="base-img" src="<%= base ? `/servers/${server.id}/items/${base.id}/icon.png` : '' %>" alt="" width="32" height="32" <%= base ? '' : 'hidden' %>></span>
      <div><strong id="base-name"><%= base ? base.name : '' %></strong><span class="muted small" id="base-meta"><%= base ? `#${base.id} · ${base.typeName}` : '' %></span></div>
    </div>
  </div>
  <label>Name of the new item
    <input name="name" value="<%= v('name', '') %>" maxlength="35" required placeholder="e.g. Emerald Wings">
    <small>Its seed is called the same, with "Seed" after it.</small>
  </label>
  <div class="save-row"><button type="submit">Create item</button></div>
</form>
<% } else { %>
<!-- ---------- edit item ---------- -->
<div class="page-head">
  <div class="player-head">
    <span class="item-ic huge <%= item.seed ? 'seed' : '' %>" data-letter="<%= (item.name || '?').slice(0, 1).toUpperCase() %>"><% if (!item.seed) { %><img class="live-icon" src="<%= iconSrc(item) %>" alt="" width="32" height="32"><% } %></span>
    <div>
      <h1><%= item.name %>
        <% if (item.custom) { %><span class="tag custom">Custom</span><% } else if (item.edited) { %><span class="tag edited">Edited</span><% } %>
      </h1>
      <p class="muted">#<%= item.id %> · <%= item.typeName %><% if (item.baseId !== null) { %> · copy of <a href="/servers/<%= server.id %>/items/<%= item.baseId %>">#<%= item.baseId %></a><% } %><% if (item.pending) { %> · added when the server next starts<% } %></p>
    </div>
  </div>
</div>

<div class="item-layout">
<form method="post" action="/servers/<%= server.id %>/items/<%= item.id %>" id="item-form" data-server="<%= server.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-book"/></svg>Name and description</h2></div>
    <label>Name
      <input name="name" id="f-name" value="<%= v('name', item.name) %>" maxlength="40" required>
    </label>
    <label class="mt">Description
      <textarea name="info" id="f-info" rows="3" maxlength="400" placeholder="What players read when they look at it."><%= v('info', item.info) %></textarea>
      <small>Shown in the item's info. Up to 400 characters.</small>
    </label>
    <div class="form-grid mt">
      <label>Rarity
        <input type="number" name="rarity" id="f-rarity" min="0" max="999" value="<%= v('rarity', item.rarity) %>">
        <small>1 to 998. 999 or 0 means no rarity.</small>
      </label>
    </div>
  </section>

  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-grid"/></svg>In the world</h2></div>
    <div class="form-grid">
      <label>Hits to break
        <input type="number" name="hits" min="0" max="42" value="<%= v('hits', item.hits) %>">
        <small>Punches with a bare fist.</small>
      </label>
      <label>Heal time (seconds)
        <input type="number" name="hitReset" min="0" max="86400" value="<%= v('hitReset', item.hitReset) %>">
        <small>How long until damage wears off.</small>
      </label>
    </div>
    <label class="mt">Collision
      <select name="collision">
        <% const coll = Number(v('collision', item.collision)); %>
        <% if (!collisions.some((c) => c.value === coll)) { %><option value="<%= coll %>" selected>Game setting (<%= coll %>)</option><% } %>
        <% for (const c of collisions) { %><option value="<%= c.value %>" <%= c.value === coll ? 'selected' : '' %>><%= c.label %></option><% } %>
      </select>
    </label>
  </section>

  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-lock"/></svg>Rules</h2></div>
    <div class="flag-list">
      <% for (const f of flags) { const on = form._csrf ? Boolean(form[f.key]) : item[f.key]; %>
      <label class="flag">
        <input type="checkbox" name="<%= f.key %>" value="1" <%= on ? 'checked' : '' %>>
        <span><strong><%= f.label %></strong><small><%= f.text %></small></span>
      </label>
      <% } %>
    </div>
  </section>

  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-image"/></svg>Look</h2><a class="btn ghost small" href="/servers/<%= server.id %>/resources"><svg class="ic"><use href="#i-upload"/></svg>Upload textures</a></div>
    <% const curTex = v('texture', item.texture); const own = textures.find((t) => t.file === curTex); %>
    <div class="tex-grid">
      <label>Texture
        <select id="tex-source">
          <% if (textures.length) { %>
          <optgroup label="Your uploads">
            <% for (const t of textures) { %><option value="<%= t.file %>" data-w="<%= t.w %>" data-h="<%= t.h %>" <%= own && own.file === t.file ? 'selected' : '' %>><%= t.file.replace(/^ps[0-9]+_/, '').replace(/_[0-9a-f]{8}\.rttex$/, '') %> (<%= t.cols * t.rows %> <%= t.cols * t.rows === 1 ? 'cell' : 'cells' %>)</option><% } %>
          </optgroup>
          <% } %>
          <option value="" <%= own ? '' : 'selected' %>>A game texture file…</option>
        </select>
        <small><%= textures.length ? 'Pick one of your uploads, or type a file from the game.' : 'Upload your own on the Resources page, or type a file from the game.' %></small>
      </label>
      <label id="game-tex" <%= own ? 'hidden' : '' %>>Game texture file
        <input name="texture" id="f-texture" value="<%= curTex %>" maxlength="64" spellcheck="false" autocomplete="off">
      </label>
      <label>Column
        <input type="number" name="texX" id="f-x" min="0" max="255" value="<%= v('texX', item.texX) %>">
      </label>
      <label>Row
        <input type="number" name="texY" id="f-y" min="0" max="255" value="<%= v('texY', item.texY) %>">
      </label>
      <span class="item-ic huge preview" id="tex-preview" data-letter="?"><img id="tex-img" src="<%= iconSrc(item) %>" alt="Texture preview" width="32" height="32"></span>
    </div>
    <div class="sheet-pick" id="sheet-pick" <%= own ? '' : 'hidden' %>>
      <p class="muted small">Click the picture you want.</p>
      <div class="sheet-wrap"><div class="sheet"><img id="pick-img" alt="Your texture" <% if (own) { %>src="/servers/<%= server.id %>/resources/<%= encodeURIComponent(own.file) %>/sheet.png" data-w="<%= own.w %>" data-h="<%= own.h %>"<% } %>><span class="sheet-cell" id="pick-cell" hidden></span></div></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-sliders"/></svg>What it is</h2></div>
    <div class="form-grid">
      <label>Item type
        <select name="type" id="f-type">
          <% const ty = Number(v('type', item.type)); %>
          <% if (!Object.hasOwn(types, ty)) { %><option value="<%= ty %>" selected>Type <%= ty %></option><% } %>
          <% for (const [k, label] of Object.entries(types).sort((a, b) => a[1].localeCompare(b[1]))) { %><option value="<%= k %>" <%= Number(k) === ty ? 'selected' : '' %>><%= label %></option><% } %>
        </select>
        <small>Changes how the game treats it. Careful with special types.</small>
      </label>
      <label>Most in one slot
        <input type="number" name="maxAmount" min="1" max="250" value="<%= v('maxAmount', item.maxAmount || 200) %>">
        <small>Usually 200.</small>
      </label>
      <label>Hit sound
        <select name="hitSound">
          <% const hs = Number(v('hitSound', item.hitSound)); const hsList = choices.hitSounds.some((c) => c.value === hs) ? choices.hitSounds : [...choices.hitSounds, { value: hs, example: '', count: 0 }]; %>
          <% for (const c of hsList) { %><option value="<%= c.value %>" <%= c.value === hs ? 'selected' : '' %>><%= c.example ? `Like ${c.example}` : `Sound ${c.value}` %><%= c.count > 1 ? ` (+${c.count - 1} more)` : '' %></option><% } %>
        </select>
        <small>What punching it sounds like.</small>
      </label>
      <label>How it joins its neighbours
        <select name="spread">
          <% const sp = Number(v('spread', item.spread)); %>
          <% if (!spreads.some((x) => x.value === sp)) { %><option value="<%= sp %>" selected>Game setting (<%= sp %>)</option><% } %>
          <% for (const x of spreads) { %><option value="<%= x.value %>" <%= x.value === sp ? 'selected' : '' %>><%= x.label %></option><% } %>
        </select>
        <small>For blocks drawn with joining edges.</small>
      </label>
    </div>
    <label class="mt">Extra file
      <input name="extraFile" value="<%= v('extraFile', item.extraFile) %>" maxlength="128" spellcheck="false" placeholder="e.g. audio/punch.wav">
      <small>A sound or animation file the game loads for this item. Leave as it is if you're not sure.</small>
    </label>
  </section>

  <% if (item.wearable) { %>
  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-user"/></svg>When worn</h2></div>
    <input type="hidden" name="powersShown" value="1">
    <div class="form-grid">
      <label>Clothing slot
        <select name="cloth">
          <% const cl = Number(v('cloth', item.cloth)); %>
          <% clothSlots.forEach((label, i) => { %><option value="<%= i %>" <%= i === cl ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
      </label>
      <label>Punch effect
        <select name="punch">
          <% const pu = Number(v('punch', item.punch)); %>
          <option value="0" <%= pu === 0 ? 'selected' : '' %>>None (plain punch)</option>
          <% const puList = choices.punches.some((c) => c.value === pu) || pu === 0 ? choices.punches : [...choices.punches, { value: pu, example: '', count: 0 }]; %>
          <% for (const c of puList) { %><option value="<%= c.value %>" <%= c.value === pu ? 'selected' : '' %>><%= c.example ? `Like ${c.example}` : `Effect ${c.value}` %> (#<%= c.value %>)</option><% } %>
        </select>
        <small>The animation and sound when the wearer punches.</small>
      </label>
    </div>
    <p class="muted small mt">Powers the wearer gets</p>
    <div class="flag-list powers">
      <% for (const p of powers) { const on = form._csrf ? Boolean(form[p.key]) : item[p.key]; %>
      <label class="flag"><input type="checkbox" name="<%= p.key %>" value="1" <%= on ? 'checked' : '' %>><span><strong><%= p.label %></strong></span></label>
      <% } %>
    </div>
  </section>
  <% } %>

  <% if (item.seed) { %>
  <section class="card">
    <div class="card-head"><h2><svg class="ic"><use href="#i-globe"/></svg>Seed and tree</h2></div>
    <div class="form-grid">
      <label>Grow time (seconds)
        <input type="number" name="grow" min="0" max="31536000" value="<%= v('grow', item.grow) %>">
        <small>How long the tree takes. 3600 is an hour.</small>
      </label>
      <label>Seed colour
        <input type="color" name="seedHex" value="<%= v('seedHex', item.seedHex) %>">
      </label>
      <label>Seed pattern colour
        <input type="color" name="seedOverlayHex" value="<%= v('seedOverlayHex', item.seedOverlayHex) %>">
      </label>
      <label>Seed shape
        <input type="number" name="seedBase" min="0" max="255" value="<%= v('seedBase', item.seedBase) %>">
      </label>
      <label>Seed pattern
        <input type="number" name="seedOverlay" min="0" max="255" value="<%= v('seedOverlay', item.seedOverlay) %>">
      </label>
      <label>Tree trunk
        <input type="number" name="treeBase" min="0" max="255" value="<%= v('treeBase', item.treeBase) %>">
      </label>
      <label>Tree leaves
        <input type="number" name="treeLeaves" min="0" max="255" value="<%= v('treeLeaves', item.treeLeaves) %>">
      </label>
    </div>
    <p class="muted small mt">Shapes are numbered pictures in the game's seed and tree textures.</p>
  </section>
  <% } else if (item.id % 2 === 0) { %>
  <p class="muted small">Its seed's colours and grow time are on <a href="/servers/<%= server.id %>/items/<%= item.id + 1 %>">the seed's page</a>.</p>
  <% } %>

  <div class="save-bar">
    <a class="btn ghost" href="/servers/<%= server.id %>/items">Cancel</a>
    <button type="submit">Save item</button>
  </div>
</form>

<aside class="item-side">
  <section class="card info-card" aria-label="How players see it">
    <p class="eyebrow">In game</p>
    <div class="info-head">
      <span class="item-ic big <%= item.seed ? 'seed' : '' %>" data-letter="<%= (item.name || '?').slice(0, 1).toUpperCase() %>"><% if (!item.seed) { %><img class="live-icon" src="<%= iconSrc(item) %>" alt="" width="32" height="32"><% } %></span>
      <div>
        <strong id="p-name"><%= v('name', item.name) %></strong>
        <span class="muted small" id="p-rarity" <%= raritySet(Number(v('rarity', item.rarity))) ? '' : 'hidden' %>>Rarity: <span id="p-rarity-n"><%= v('rarity', item.rarity) %></span></span>
      </div>
    </div>
    <p id="p-info" class="info-text"><%= v('info', item.info) || 'No description.' %></p>
  </section>
  <section class="card <%= item.custom ? 'danger' : '' %>">
    <% if (item.custom) { %>
      <div class="card-head"><h2><svg class="ic"><use href="#i-trash"/></svg>Delete item</h2></div>
      <p class="small">Removes it and its seed. Anyone who has it keeps an empty slot. It can't be undone.</p>
      <form method="post" action="/servers/<%= server.id %>/items/<%= item.id %>/reset">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="bad">Delete <%= item.name %></button>
      </form>
    <% } else { %>
      <div class="card-head"><h2><svg class="ic"><use href="#i-restart"/></svg>Original</h2></div>
      <p class="small muted"><%= item.edited ? 'Undo every change and use what items.dat says again.' : 'Not changed. This is how items.dat has it.' %></p>
      <% if (item.edited) { %>
      <form method="post" action="/servers/<%= server.id %>/items/<%= item.id %>/reset">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="ghost">Reset to original</button>
      </form>
      <% } %>
      <a class="btn ghost small mt-btn" href="/servers/<%= server.id %>/items/new?base=<%= item.id %>"><svg class="ic"><use href="#i-copy"/></svg>Make a new item from this</a>
    <% } %>
  </section>
</aside>
</div>
<% } %>
<%- include('partials/server-shell-end') %>
