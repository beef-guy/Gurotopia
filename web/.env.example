# Copy to .env for local testing (npm run panel / npm run supervisor).
# On the VPS the same settings live in /etc/gurotopia/panel.env, read by systemd.

# MariaDB: one user for the website and supervisor. It creates and drops srv_* databases.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gurotopia_panel
DB_PASSWORD=change-me
PLATFORM_DB=gurotopia_platform

# Website
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
PANEL_PUBLIC_URL=https://panel.psnode.cloud
COOKIE_SECURE=true
# Leave empty to let anyone sign up, or set a code to keep it invite-only.
SIGNUP_CODE=
SERVERS_PER_USER=3
MAX_PLAYERS_LIMIT=100
DEFAULT_MAX_PLAYERS=50
SESSION_DAYS=14
# What players point the game at, shown on each server's page.
GAME_ADDRESS=psnode.cloud

# Supervisor (only listens on 127.0.0.1). Make the token with: openssl rand -hex 32
SUPERVISOR_PORT=3001
SUPERVISOR_TOKEN=
# Folder with main.out, items.dat, resources/ and mysql_login.txt
GAME_DIR=/opt/gurotopia
GAME_BIN=main.out
# One folder per server is made here
SERVERS_DIR=/srv/gurotopia/servers
STOP_TIMEOUT_SECONDS=30
MAX_CRASHES=5
CRASH_WINDOW_MINUTES=10
LOG_MAX_BYTES=2097152

# UDP ports handed to new servers. 17091 is the gateway.
FIRST_GAME_PORT=17100
LAST_GAME_PORT=17999
